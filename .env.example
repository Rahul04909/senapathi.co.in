# ==============================================================================
# SENAPATHI ALLIANCE - ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env and fill in your production credentials
# ==============================================================================

APP_NAME="Senapathi Alliance"
APP_ENV=production
APP_URL=https://senapathi.co.in

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# SMTP Configuration (PHPMailer)
SMTP_HOST=mail.senapathi.co.in
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true
SMTP_USER=info@senapathi.co.in
SMTP_PASS=
SMTP_FROM_EMAIL=info@senapathi.co.in
SMTP_FROM_NAME="Senapathi Alliance"

# Destination email for inquiries
NOTIFICATION_RECIPIENT_EMAIL=info@senapathi.co.in
